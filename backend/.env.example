# AI API 配置
AI_API_KEY=your-api-key-here
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 服务端口
PORT=3001

# 本地 MySQL 8.0+（先启动 MySQL，再执行 npm run db:setup）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ai_frontend_interview
MYSQL_CONNECTION_LIMIT=4

# 首次先使用 off 跑通基本流程；完成 knowledge:download 和 knowledge:setup 后启用
# off 关闭自动增强；prefer 尝试检索，局部不可用可回退常规出题
# 数据库错误与用户取消不会被当作普通知识缺失回退
RAG_MODE=off
