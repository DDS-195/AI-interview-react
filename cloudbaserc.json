{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "your-env-id",
  "version": "2.0",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "ai-interview-backend",
      "timeout": 60,
      "runtime": "Nodejs18",
      "handler": "server.main",
      "envVariables": {
        "PORT": "3001",
        "AI_API_BASE_URL": "your-api-base-url",
        "AI_MODEL": "your-model-name",
        "NODE_ENV": "production",
        "TCB_SERVERLESS": "true"
      }
    }
  ]
}
